   "source": [
    "# Variance, Covariance, and Correlation\n",
    "\n",
    "$$\n",
    "\\begin{aligned}\n",
    "\\mathrm{Cov}(X, Y) &= \\mathbb{E}(X - \\mathbb{E}X)(Y - \\mathbb{E}Y)\\\\\n",
    "& = \\mathbb{E}(XY) - \\mathbb{E}X\\mathbb{E}Y\n",
    "\\end{aligned}\n",
    "$$"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "72741acd",
   "metadata": {},
   "source": [
    "$$\n",
    "\\mathrm{Var}(X + Y) = \\mathrm{Var}(X) + \\mathrm{Var}(Y) + \\mathrm{Cov}(X, Y)\n",
    "$$"
   ]
  }
 ],
